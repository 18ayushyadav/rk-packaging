# RK Packaging - Environment Configuration
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client bundle.
# Never place secret API keys or private credentials in this file.

# WhatsApp business number (digits with country code, e.g., 918447849753)
VITE_WHATSAPP_NUMBER=918447849753

# Public phone display format
VITE_PHONE_DISPLAY=+91 84478 49753

# Public contact email (leave empty or configure when official domain email is ready)
VITE_CONTACT_EMAIL=info@rkpackaging.in

# Canonical website URL for Open Graph and metadata
VITE_SITE_URL=https://rkpackaging.in
